# ============================================================================
# .env 只放「敏感信息」（API key 等），不入 git 仓库（已被 .gitignore 忽略）
#
# 使用方法：
#   cp .env.example .env
#   # 然后填入下面你想用的那一家的 key 即可
#
# 不放这里的东西：
#   - HOST / PORT / FLASK_DEBUG / WEIGHTS_PATH / LLM_PROVIDER 等非敏感配置
#   - 它们的默认值都在 src/plant_disease/config.py 里
#   - 想覆盖时再在自己机器的 .env 里临时加一行即可（不会被 commit）
# ============================================================================

# 选用哪家 LLM：mock | openai | baidu | alibaba
# - 默认 mock，离线就能跑，不需要 key
# - 想用真实 LLM，改成对应的名字 + 填下面的 key
LLM_PROVIDER=mock

# 阿里通义千问（推荐，对中文好）
# 申请：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# OpenAI
OPENAI_API_KEY=

# 百度文心一言（同时需要 API Key 和 Secret Key）
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
