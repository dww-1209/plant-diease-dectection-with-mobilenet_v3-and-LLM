# ============================================================================
# .env 只放「敏感信息」（API key 等），不入 git 仓库（已被 .gitignore 忽略）
#
# 使用方法：
#   cp .env.example .env
#   # 然后填入下面你想用的那一家的 key 即可
#
# 不放这里的东西：
#   - HOST / PORT / FLASK_DEBUG / WEIGHTS_PATH / LLM_PROVIDER 等非敏感配置
#   - 它们的默认值都在 src/plant_disease/config.py 里
#   - 想覆盖时再在自己机器的 .env 里临时加一行即可（不会被 commit）
#
# 选哪家 LLM？
#   - 默认 LLM_PROVIDER=auto，会按 openai → deepseek → alibaba → zhipu → mock
#     顺序自动选第一个配了 key 的。
#   - 一个 key 都没填也能跑：自动落到内置 mock，返回占位文案。
#   - 想强制指定，把 LLM_PROVIDER 写到 .env 里：openai / deepseek / alibaba /
#     zhipu / mock。
# ============================================================================

# OpenAI（auto 模式下优先级最高）
OPENAI_API_KEY=

# DeepSeek（OpenAI 兼容）
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 阿里通义千问 DashScope（OpenAI 兼容模式）
# 申请：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=

# 智谱 GLM（OpenAI 兼容）
# 申请：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=
